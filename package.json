{
  "name": "studio-landing-page",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "build": "node scripts/build.js",
    "check:browser-syntax": "es-check es2018 build/static/js/main.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o .out",
    "chromatic": "npx chromatic --project-token b85a2f6d9260",
    "lint": "biome check",
    "lint-fix": "biome check --write",
    "format": "biome format --write",
    "format-check": "biome format",
    "typescript:check": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@babel/plugin-transform-runtime": "8.0.6",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@biomejs/biome": "2.6.3",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-links": "10.6.0",
    "@storybook/addon-webpack5-compiler-babel": "4.0.1",
    "@storybook/react": "10.6.0",
    "@storybook/react-webpack5": "10.6.0",
    "@svgr/webpack": "8.1.0",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "babel-loader": "10.1.1",
    "bfj": "9.1.4",
    "case-sensitive-paths-webpack-plugin": "2.4.0",
    "chromatic": "18.13.3",
    "dotenv": "18.0.9",
    "dotenv-expand": "13.0.0",
    "es-check": "9.8.1",
    "file-loader": "6.2.0",
    "fs-extra": "11.4.1",
    "html-webpack-plugin": "5.6.8",
    "pnp-webpack-plugin": "1.7.0",
    "react-dev-utils": "12.0.1",
    "resolve": "1.22.13",
    "semver": "7.8.5",
    "storybook": "10.6.2",
    "terser-webpack-plugin": "5.6.1",
    "ts-pnp": "1.2.0",
    "typescript": "5.9.3",
    "url-loader": "4.1.1",
    "webpack": "5.112.2",
    "webpack-dev-server": "6.1.0",
    "webpack-manifest-plugin": "6.0.1",
    "workbox-webpack-plugin": "7.4.1"
  },
  "overrides": {
    "@storybook/builder-webpack5@^10": {
      "webpack-dev-middleware": "^8.3.0"
    }
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "exclude": [
            "transform-typeof-symbol"
          ]
        }
      ],
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ],
      "@babel/preset-typescript"
    ]
  }
}
