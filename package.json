{
  "name": "studio-landing-page",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "build": "node scripts/build.js",
    "check:browser-syntax": "es-check es2018 build/static/js/main.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o .out",
    "chromatic": "npx chromatic --project-token b85a2f6d9260",
    "lint": "biome check",
    "lint-fix": "biome check --write",
    "format": "biome format --write",
    "format-check": "biome format",
    "typescript:check": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@biomejs/biome": "2.5.12",
    "@emotion/babel-preset-css-prop": "^11.11.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/react": "^10.6.0",
    "@storybook/react-webpack5": "^10.6.0",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "babel-loader": "8.1.0",
    "babel-plugin-named-asset-import": "^0.3.7",
    "babel-preset-react-app": "^10.0.0",
    "bfj": "^7.0.2",
    "case-sensitive-paths-webpack-plugin": "2.3.0",
    "chromatic": "^18.7.2",
    "css-loader": "^6.10.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv": "8.2.0",
    "dotenv-expand": "5.1.0",
    "es-check": "^9.6.4",
    "file-loader": "6.1.1",
    "fs-extra": "^9.0.1",
    "html-webpack-plugin": "5.2.0",
    "mini-css-extract-plugin": "0.11.3",
    "pnp-webpack-plugin": "1.6.4",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-loader": "^8.1.1",
    "postcss-normalize": "^10.0.1",
    "postcss-preset-env": "^9.5.2",
    "postcss-safe-parser": "5.0.2",
    "react-dev-utils": "^12.0.1",
    "resolve": "1.18.1",
    "resolve-url-loader": "^5.0.0",
    "sass-loader": "^10.0.5",
    "semver": "7.6.2",
    "storybook": "^10.6.0",
    "style-loader": "1.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-pnp": "1.2.0",
    "typescript": "^5.9.3",
    "url-loader": "4.1.1",
    "web-vitals": "^1.1.1",
    "webpack": "^5.91.0",
    "webpack-dev-server": "^6.0.0",
    "webpack-manifest-plugin": "5.0.0",
    "workbox-webpack-plugin": "^7.0.0"
  },
  "babel": {
    "presets": [
      [
        "react-app",
        {
          "runtime": "automatic"
        }
      ]
    ]
  }
}
